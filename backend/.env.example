# Same Supabase pooled Postgres URL as the main app's DATABASE_URL (../.env).
# The chatbot only issues read-only queries against it.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Groq — https://console.groq.com
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# JSON array of allowed frontend origins. Next.js falls back to 3001 when
# 3000 is already taken, so both are allow-listed by default for local dev.
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]
